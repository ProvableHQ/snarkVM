function claim_multi_hop_output:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as field.public;
    input r6 as u128.public;
    input r7 as field.public;
    input r8 as u128.public;
    input r9 as address.public;
    call.dynamic r2 'aleo' 'transfer_public' with r9 r3 (as address.public u128.public) into r10 (as dynamic.future);
    call.dynamic r1 'aleo' 'transfer_public' with r9 r4 (as address.public u128.public) into r11 (as dynamic.future);
    call.dynamic r5 'aleo' 'transfer_public' with r9 r6 (as address.public u128.public) into r12 (as dynamic.future);
    call.dynamic r7 'aleo' 'transfer_public' with r9 r8 (as address.public u128.public) into r13 (as dynamic.future);
    async claim_multi_hop_output r10 r11 r12 r13 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 self.caller into r14;
    output r14 as leo_amm.aleo/claim_multi_hop_output.future;

finalize claim_multi_hop_output:
    input r0 as dynamic.future;
    input r1 as dynamic.future;
    input r2 as dynamic.future;
    input r3 as dynamic.future;
    input r4 as field.public;
    input r5 as field.public;
    input r6 as field.public;
    input r7 as u128.public;
    input r8 as u128.public;
    input r9 as field.public;
    input r10 as u128.public;
    input r11 as field.public;
    input r12 as u128.public;
    input r13 as address.public;
    input r14 as address.public;
    await r0;
    await r1;
    await r2;
    await r3;
    get swap_outputs[r4] into r15;
    is.eq r15.caller r14 into r16;
    assert.eq r16 true;
    is.eq r15.recipient r13 into r17;
    assert.eq r17 true;
    is.eq r15.token_in r5 into r18;
    assert.eq r18 true;
    is.eq r15.token_out r6 into r19;
    assert.eq r19 true;
    is.eq r15.amount_out r7 into r20;
    assert.eq r20 true;
    is.eq r15.amount_remaining r8 into r21;
    assert.eq r21 true;
    is.eq r15.token_in_1 r9 into r22;
    assert.eq r22 true;
    is.eq r15.amount_remaining_1 r10 into r23;
    assert.eq r23 true;
    is.eq r15.token_in_2 r11 into r24;
    assert.eq r24 true;
    is.eq r15.amount_remaining_2 r12 into r25;
    assert.eq r25 true;
    remove swap_outputs[r4];

function claim_multi_hop_output_private:
    input r0 as scalar.private;
    input r1 as u32.private;
    input r2 as address.private;
    input r3 as field.public;
