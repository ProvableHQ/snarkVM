    cast r1 into r16 as field;
    cast r14 r15 r16 into r17 as [field; 3u32];
    hash.bhp256.raw r17 into r18 as scalar;
    commit.bhp256 self.signer r18 into r19 as address;
    assert.eq r19 r2;
