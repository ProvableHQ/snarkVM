    cast leo_amm.aleo into r12 as field;
    cast r0 into r13 as field;
    cast r1 into r14 as field;
    cast r12 r13 r14 into r15 as [field; 3u32];
    hash.bhp256.raw r15 into r16 as scalar;
    commit.bhp256 self.signer r16 into r17 as address;
    assert.eq r17 r2;
    mul aleo::GENERATOR r0 into r18;
    cast r18 into r19 as address;
    is.eq r19 self.signer into r20;
    assert.eq r20 true;
    call.dynamic r5 'aleo' 'transfer_public_to_private' with self.signer r6 (as address.private u128.public) into r21 r22 (as dynamic.record dynamic.future);
    call.dynamic r4 'aleo' 'transfer_public_to_private' with self.signer r7 (as address.private u128.public) into r23 r24 (as dynamic.record dynamic.future);
    call.dynamic r8 'aleo' 'transfer_public_to_private' with self.signer r9 (as address.private u128.public) into r25 r26 (as dynamic.record dynamic.future);
    call.dynamic r10 'aleo' 'transfer_public_to_private' with self.signer r11 (as address.private u128.public) into r27 r28 (as dynamic.record dynamic.future);
    async claim_multi_hop_output_private r22 r24 r26 r28 r3 r4 r5 r6 r7 r8 r9 r10 r11 r2 into r29;
    output r21 as dynamic.record;
    output r23 as dynamic.record;
    output r25 as dynamic.record;
    output r27 as dynamic.record;
    output r29 as leo_amm.aleo/claim_multi_hop_output_private.future;

