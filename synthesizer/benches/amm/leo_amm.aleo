    cast r20 into r21 as address;
    is.eq r21 self.signer into r22;
    assert.eq r22 true;
    cast r4 r5 r6 r7 r2 r8 r9 r10 r11 r12 r13 r2 into r23 as SwapMultiHopRequest;
    cast r4 r5 r6 r7 r2 r8 r9 r10 r11 r12 r13 r2 into r24 as SwapMultiHopRequest;
